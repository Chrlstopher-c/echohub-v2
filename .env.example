# EchoHub v2 — variables d'environnement. Copier en `.env` (jamais versionné) et ajuster.

# --- Ports hôte ------------------------------------------------------------------------------
# Distincts de la v1 (37820/37821/37822) : les deux versions peuvent tourner en même temps sur
# la même machine sans se disputer un port. Mesuré : avec les anciens défauts, le backend v2
# échouait à se binder ("Address already in use") pendant qu'un curl /docs répondait 200 —
# servi par la v1, pas par elle.
# 37920 : interface web servie par nginx dans le conteneur.
# 37921 : API FastAPI, exposée directement pour le débogage.
# 37922 : serveur de développement Vite, uniquement en exécution native (./start.sh).
ECHOHUB_PORT_WEB=37920
ECHOHUB_PORT_API=37921
ECHOHUB_PORT_FRONT_DEV=37922

# --- Journalisation --------------------------------------------------------------------------
# Niveau loguru : TRACE, DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Hugging Face ----------------------------------------------------------------------------
# Jeton nécessaire seulement pour les dépôts privés ou sous licence acceptée. Laisser vide sinon.
HF_TOKEN=

# --- Chemins de données ----------------------------------------------------------------------
# Valeurs internes au conteneur, définies dans le Dockerfile et montées sur des volumes nommés.
# Ne les redéfinir ici QUE pour une exécution native, avec des chemins hôte existants.
# MODELS_DIR=/data/models
# XDG_DATA_HOME=/data/user
#
# Sans XDG_DATA_HOME, le backend range ses données sous <racine>/echohub-v2/ (cf.
# backend/core/config.py, NOM_APPLICATION) — distinct de <racine>/echohub/ utilisé par la v1.
# Les deux versions peuvent donc partager le même XDG_DATA_HOME hôte sans lire la même base
# SQLite ni écrire dans les mêmes répertoires modèles/moteurs.

# --- Piège documenté : ne pas définir ---------------------------------------------------------
# GGML_CUDA_ENABLE_UNIFIED_MEMORY n'a délibérément aucune ligne active ici. Sous WSL2, elle
# laisse le modèle en RAM avec la VRAM figée à 2 Go (mesuré : chargement de plusieurs minutes,
# modèle inutilisable ; sans elle, 12 s et 14,8 Go réellement en VRAM). ggml l'active sur la
# simple présence de la variable : même vide, elle nuit.

# --- Atelier d'exécution ---------------------------------------------------------------------
# Le backend délègue l'exécution du code et des commandes du modèle à un conteneur de dev
# persistant (echohub-atelier), sur le réseau interne (aucun port publié). Le jeton partagé garde
# ce service qui exécute du shell root : le générer avec `python3 -c "import secrets;
# print(secrets.token_urlsafe(32))"`. Vide = exécution refusée côté atelier (repli fermé).
ATELIER_JETON=
# URL interne de l'atelier (défaut : nom de service Docker). Rarement à changer.
# ATELIER_URL=http://echohub-atelier:8080

# --- Authentification web (nginx) ------------------------------------------------------------
# Activée par la SEULE PRÉSENCE des deux variables ; absentes, l'interface est ouverte à qui
# atteint le port. Les engendrer avec `docker compose exec echohub
# /app/backend/.venv/bin/python docker/outils-acces.py` : le mot de passe s'affiche une fois,
# seule l'empreinte crypt salée est conservée. Seul 127.0.0.1 en est exempté (healthcheck).
# Elle protège l'ACCÈS, pas les données : un seul compte, sans session ni révocation.
ECHOHUB_AUTH_USER=
ECHOHUB_AUTH_HASH=

# --- Recherche web ----------------------------------------------------------------------------
# SearXNG refuse de démarrer sans clé. Un repli en clair existe dans docker/searxng/settings.yml —
# il est public depuis l'ouverture du dépôt, donc à surcharger ici.
SEARXNG_SECRET=
